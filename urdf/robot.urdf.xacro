<?xml version="1.0"?>
<!--
  robot.urdf.xacro — File gốc: gộp tất cả xacro thành 1 URDF
  =============================================================
  TUẦN 4: thêm 2 include cho Gazebo simulation.

  robot_state_publisher đọc file này qua launch file,
  xử lý tất cả <xacro:include>, publish URDF lên /robot_description.
-->
<robot name="my_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Kích thước & hằng số -->
  <xacro:include filename="$(find my_robot_description)/urdf/properties.xacro"/>

  <!-- Màu sắc RViz -->
  <xacro:include filename="$(find my_robot_description)/urdf/materials.xacro"/>

  <!-- Macro tính inertia -->
  <xacro:include filename="$(find my_robot_description)/urdf/macros.xacro"/>

  <!-- Links + Joints (Tuần 3 + fixes Tuần 4) -->
  <xacro:include filename="$(find my_robot_description)/urdf/robot_core.xacro"/>

  <!-- TUẦN 4 MỚI: DiffDrive plugin → robot nhận /cmd_vel, xuất /odom -->
  <xacro:include filename="$(find my_robot_description)/urdf/gazebo_control.xacro"/>

  <!-- TUẦN 4 MỚI: LiDAR → /scan, Camera → /camera/image_raw -->
  <xacro:include filename="$(find my_robot_description)/urdf/sensors.xacro"/>

</robot>
